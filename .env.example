# Environment variables for the DB connection
DATABASE_DRIVER="postgres"
# Environment variables for the NestJS app
PORT=3000

# MongoDB
# DATABASE_URL="mongodb://localhost:27017/afisha"

# PostgreSQL
DATABASE_NAME=afisha
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USERNAME=film_user
DATABASE_PASSWORD=film_pass

# Logger type: 'json', 'tskv', 'dev'
LOGGER_TYPE=dev

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_LISTEN_PORT=8080

# GitHub Container Registry
GHCR_OWNER=andrey-mskv
IMAGE_TAG=latest

NGINX_PORT=80
NGINX_SSL_PORT=443

